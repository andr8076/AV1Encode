{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andr8076/AV1Encode/blob/main/docs/requirements-v2.schema.json",
  "title": "AV1Encode protocol-v2 requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_version",
    "input",
    "output",
    "hardware_policy",
    "quality",
    "optimization",
    "video",
    "preservation",
    "audio"
  ],
  "properties": {
    "schema": {"const": "av1encode.requirements"},
    "protocol_version": {"const": 2},
    "input": {"type": "string", "minLength": 1},
    "output": {"type": "string", "minLength": 1, "pattern": "\\.[mM][kK][vV]$"},
    "hardware_policy": {"enum": ["auto_hardware_only", "manual_software"]},
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "target", "p10_minimum", "sustained_floor", "maximum_sustained_seconds"],
      "properties": {
        "metric": {"enum": ["vmaf", "ssim_percent"]},
        "target": {"type": "number", "minimum": 0, "maximum": 100},
        "p10_minimum": {"type": "number", "minimum": 0, "maximum": 100},
        "sustained_floor": {"type": "number", "minimum": 0, "maximum": 100},
        "maximum_sustained_seconds": {"type": "number", "minimum": 0, "maximum": 60}
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"enum": ["smallest_output", "fastest_encoding", "highest_quality"]},
        "secondary": {"enum": ["smallest_output", "fastest_encoding", "highest_quality"]}
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_height", "denoise"],
      "properties": {
        "maximum_height": {"type": ["integer", "null"], "minimum": 144},
        "denoise": {"enum": ["auto", "never"]}
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streams", "chapters", "metadata"],
      "properties": {
        "streams": {"const": "all"},
        "chapters": {"const": true},
        "metadata": {"const": true}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "copy_all"}}
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"sample_seconds": {"type": "number", "minimum": 1, "maximum": 10}}
    }
  }
}
